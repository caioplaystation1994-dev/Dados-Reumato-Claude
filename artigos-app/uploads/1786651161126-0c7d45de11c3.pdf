      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Background: Antinuclear antibodies (ANA) are major immunodiagnostic tools in systemic lupus erythematosus (SLE); however, their clinical and pathogenic roles are not yet elucidated and are a subject of controversy.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Anti-Nuclear Antibodies Patterns in Patients With Systemic Lupus Erythematosus and Their Correlation With Other Diagnostic Immunological Parameters</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Jamil A. Al-Mughales</rdf:li>
            </rdf:Seq>
